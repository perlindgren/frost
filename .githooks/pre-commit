#!/bin/sh
# Gate before a commit lands: format the whole workspace, re-stage only the
# .rs files that were already staged (so unstaged working-tree changes stay
# out of the commit), then hold clippy to ZERO warnings on every target.
#
# The web build (the wasm32-unknown-unknown target — its only consumer in
# this repo, see `text_web`) is deliberately out of this loop for now; it is
# checked by hand and can be brought back here later. The check is SCOPED to
# the library:
#     cargo check --target wasm32-unknown-unknown -p frost
# — the `sprite_util` tool is a workspace member (and a default one), and a
# bare wasm check would build the native-only tool too (rfd, env_logger);
# `-p frost` keeps wasm meaning "the engine compiles for the web", which is
# the claim the check exists to make.
#
# This repo enforces via .githooks/; the link lives in per-clone config,
# so a fresh clone opts in once:
#     sh .githooks/install.sh
staged=$(git diff --name-only --cached)

# OS and build droppings never get in, however they were staged. `.gitignore`
# has carried `**/.DS_Store` for a long time and three of them were still
# tracked, because an ignore rule speaks only to *untracked* files: once a
# dropper lands it stays through every rule written afterwards, and `git add -f`
# defeats the rule anyway. So the check is here, before cargo is invoked at all.
#
# Builtins only — `case`, `printf`, no `grep` and no `sed`. The first draft used
# `grep`, and tested with Git's usr/bin off PATH it printed `grep: command not
# found` and exited 0: a guard that fails open is worse than none, because it is
# trusted. Nothing here can be missing. (Like the re-stage loop below, paths
# containing spaces would split. That was written as an accepted trade in a tree
# without any, and the SDK scan below broke the premise: `Steinberg ASIO
# Licensing Agreement.pdf` is refused on the word `Steinberg` and printed in two
# pieces, which was measured, not imagined. Refusing is the part that has to
# work; the name is complete in `git status`, two commands from the fix.)
#
# Only additions, copies, modifications and renames are examined, never
# deletions: without that filter the commit whose whole job is to remove a
# dropper would be refused by the guard built to punish it.
junk=
for f in $(git diff --cached --name-only --diff-filter=ACMR); do
    case $f in
        .DS_Store|*/.DS_Store|Thumbs.db|*/Thumbs.db|desktop.ini|*/desktop.ini|._*|*/._*)
            junk="$junk $f" ;;
        __pycache__/*|*/__pycache__/*|*.pyc|*.orig|*.rej)
            junk="$junk $f" ;;
    esac
done
if [ -n "$junk" ]; then
    printf 'pre-commit: refusing to commit OS/build droppings:\n' >&2
    for f in $junk; do printf '  %s\n' "$f" >&2; done
    printf 'pre-commit: git rm --cached <path>, delete the file, commit again.\n' >&2
    exit 1
fi

# Third-party proprietary SDKs never get in, and `git add -A` is the way they
# would. A cargo home beside a project is a cache, but the plugin project this
# engine is being joined by keeps one in its tree — and inside it sits a complete
# unpacked Steinberg ASIO SDK: 48 files, 10 MB, `asio.h` and `iasiodrv.h`, the
# licensing agreement PDF and 3 MB of logo artwork. Steinberg's licence for that
# SDK is proprietary, incompatible with this repository's `MIT OR Apache-2.0`,
# and cpal's build script downloads it into exactly that path (`CPAL_ASIO_DIR`).
# `.gitignore` now says `.cargohome/`, and the lesson of the droppings scan above
# is that an ignore rule speaks only to *untracked* files — so the check is here
# as well, on what is actually staged, builtins only for the same reason.
sdk=
for f in $(git diff --cached --name-only --diff-filter=ACMR); do
    case $f in
        .cargohome/*|*/.cargohome/*)
            sdk="$sdk $f" ;;
        asiosdk/*|*/asiosdk/*)
            sdk="$sdk $f" ;;
        asio.h|*/asio.h|iasiodrv.h|*/iasiodrv.h)
            sdk="$sdk $f" ;;
        asiodrvr.cpp|*/asiodrvr.cpp|asiolist.cpp|*/asiolist.cpp|hostsample.cpp|*/hostsample.cpp)
            sdk="$sdk $f" ;;
        *Steinberg*|*steinberg*)
            sdk="$sdk $f" ;;
    esac
done
if [ -n "$sdk" ]; then
    printf 'pre-commit: refusing to commit a third-party proprietary SDK.\n' >&2
    for f in $sdk; do printf '  %s\n' "$f" >&2; done
    printf 'pre-commit: the Steinberg ASIO SDK is proprietary, not MIT/Apache-2.0.\n' >&2
    printf 'pre-commit: keep it outside the repository (CPAL_ASIO_DIR may point anywhere else).\n' >&2
    exit 1
fi

cargo fmt --all || exit 1
for f in $staged; do
    case $f in
        *.rs) git add "$f" ;;
    esac
done

printf 'pre-commit: clippy -D warnings (native, all targets)...\n'
cargo clippy --all-targets -- -D warnings || {
    printf 'pre-commit: clippy failed - commit aborted.\n' >&2
    exit 1
}

exit 0
